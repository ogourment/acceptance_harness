def make_handler(preview):
    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            return

        def do_GET(self):
            parsed = urlsplit(self.path)
            if parsed.path == "/events":
                query = dict(
                    part.split("=", 1) if "=" in part else (part, "")
                    for part in parsed.query.split("&") if part
                )
                client_id = unquote(query.get("client", ""))
                linked_source = self.safe_target(unquote(query.get("source", "")))
                if query.get("source") and (linked_source is None or linked_source.suffix.lower() not in (".md", ".markdown")):
                    self.send_error(404)
                    return
                if not client_id:
                    self.send_error(400, "missing client id")
                    return
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-cache")
                self.send_header("Connection", "keep-alive")
                self.end_headers()
                messages = queue.Queue()
                preview.add_client(client_id, messages)
                try:
                    self.wfile.write(b": connected\n\n")
                    self.wfile.flush()
                    while not preview.shutdown_requested.is_set():
                        try:
                            message = messages.get(timeout=2)
                        except queue.Empty:
                            message = "event: heartbeat\ndata: " + json.dumps(preview.synchronization(linked_source)) + "\n\n"
                        self.wfile.write(message.encode())
                        self.wfile.flush()
                except OSError:
                    pass
                finally:
                    preview.remove_client(client_id, messages)
                return

            path = unquote(urlsplit(self.path).path)
            requested = "index.html" if path in ("/", "/index.html") else path.lstrip("/")
            if requested == "index.html":
                try:
                    data = preview.html().encode()
                except (OSError, UnicodeError):
                    self.send_error(503, "Preview unavailable; retry shortly")
                    return
                content_type = "text/html; charset=utf-8"
            else:
                target = self.safe_target(requested)
                if target is None:
                    self.send_error(404)
                    return
                if target.suffix.lower() in (".md", ".markdown"):
                    try:
                        data = preview.html(target).encode()
                    except (OSError, UnicodeError, subprocess.SubprocessError):
                        self.send_error(503, "Preview unavailable; retry shortly")
                        return
                    content_type = "text/html; charset=utf-8"
                else:
                    data = target.read_bytes()
                    content_type = mimetypes.guess_type(target.name)[0] or "application/octet-stream"
            if not data:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def safe_target(self, requested):
            if not requested:
                return None
            root = preview.serve_root
            target = (root / requested).resolve()
            hidden = any(part.startswith(".") for part in Path(requested).parts)
            if hidden or root not in target.parents or not target.is_file():
                return None
            return target

        def do_POST(self):
            parsed = urlsplit(self.path)
            if parsed.path == f"/disconnect/{preview.shutdown_token}":
                query = dict(
                    part.split("=", 1) if "=" in part else (part, "")
                    for part in parsed.query.split("&") if part
                )
                client_id = unquote(query.get("client", ""))
                if client_id:
                    preview.remove_client(client_id)
                self.send_response(204)
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                return
            if self.path != f"/shutdown/{preview.shutdown_token}":
                self.send_error(404)
                return
            self.send_response(204)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            preview.shutdown_requested.set()
            threading.Thread(target=self.server.shutdown, daemon=True).start()

    return Handler


def watch(preview):
    # One stat every 250 ms is cheap and does not consume the user's scarce
    # inotify instances. Heartbeats separately verify revisions every 2 seconds.
    while not preview.shutdown_requested.wait(0.25):
        if preview.refresh():
            preview.reload_clients()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--version", action="version", version=VERSION)
    parser.add_argument("--mode", choices=("html", "markdown"), default="markdown")
    parser.add_argument("--source", required=True)
    parser.add_argument("--serve-root")
    parser.add_argument("--output")
    parser.add_argument("--css")
    parser.add_argument("--source-label")
    parser.add_argument("--fallback-title", default="Preview")
    parser.add_argument(
        "--path-boundary-regex",
        default=os.environ.get(
            "LIVE_PREVIEW_PATH_BOUNDARY_REGEX", DEFAULT_PATH_BOUNDARY_REGEX
        ),
        help="directory-component regex at which to collapse the displayed path",
    )
    parser.add_argument("--ready", required=True)
    parser.add_argument("--pidfile", required=True)
    parser.add_argument("--idle-timeout", type=float, default=12)
    parser.add_argument("--startup-timeout", type=float, default=60)
    parser.add_argument("--bind", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--port-ledger")
    parser.add_argument("--detach", action="store_true")
    args = parser.parse_args()
    try:
        re.compile(args.path_boundary_regex)
    except re.error as error:
        parser.error(f"invalid --path-boundary-regex: {error}")
    if args.detach and not detach():
        return 0
    preview = Preview(args)
    if not preview.refresh():
        return 1

    if not 0 <= args.port <= 65535:
        parser.error("--port must be between 0 and 65535")

    ledger_port = read_port_ledger(args.port_ledger) if args.port == 0 else None
    selected_port = ledger_port or args.port
    try:
        server = http.server.ThreadingHTTPServer(
            (args.bind, selected_port), make_handler(preview)
        )
    except OSError:
        if ledger_port is None:
            raise
        server = http.server.ThreadingHTTPServer((args.bind, 0), make_handler(preview))
    server.daemon_threads = True
    if args.port == 0 and args.port_ledger:
        write_port_ledger(args.port_ledger, server.server_port)
    url_hosts = [args.bind]
    if args.bind in ("0.0.0.0", "::"):
        url_hosts = ["127.0.0.1", socket.gethostname()]
        try:
            url_hosts.extend(
                subprocess.run(
                    ["hostname", "-I"], capture_output=True, text=True, check=False
                ).stdout.split()
            )
        except OSError:
            pass
        try:
            url_hosts.extend(
                subprocess.run(
                    ["tailscale", "ip", "-4"], capture_output=True, text=True, check=False
                ).stdout.split()
            )
        except OSError:
            pass
    url_hosts = list(dict.fromkeys(host for host in url_hosts if host))
    urls = [
        f"http://{'[' + host + ']' if ':' in host else host}:{server.server_port}/"
        for host in url_hosts
    ]
    url = urls[0]
    preview.pidfile.write_text(str(os.getpid()) + "\n")
    preview.ready.write_text(
        json.dumps(
            {
                "pid": os.getpid(),
                "url": url,
                "urls": urls,
                "bind": args.bind,
                "port": server.server_port,
            }
        )
        + "\n"
    )

    def stop(*_):
        preview.shutdown_requested.set()
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    threading.Thread(target=watch, args=(preview,), daemon=True).start()
    started = time.monotonic()
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        while not preview.shutdown_requested.wait(1):
            if preview.should_stop(started):
                stop()
    finally:
        server.server_close()
        preview.ready.unlink(missing_ok=True)
        preview.pidfile.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
