DEFAULT_PATH_BOUNDARY_REGEX = r"tmp"
VERSION = "0.11.3"


def read_port_ledger(path):
    """Return a previously assigned preview port, ignoring stale/corrupt state."""
    if not path:
        return None
    try:
        port = int(Path(path).read_text(encoding="ascii").strip())
    except (OSError, ValueError):
        return None
    return port if 0 < port <= 65535 else None


def write_port_ledger(path, port):
    """Atomically retain an automatically assigned port for a future watcher."""
    path = Path(path)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(descriptor, f"{port}\n".encode("ascii"))
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def file_signature(path):
    """Return enough metadata to notice an atomic save on any supported host."""
    try:
        stat = Path(path).stat()
    except OSError:
        return None
    return stat.st_mtime_ns, stat.st_size, stat.st_ino


def detach():
    """Detach the preview server without relying on platform-specific nohup."""
    if os.fork():
        return False
    os.setsid()
    if os.fork():
        os._exit(0)
    return True


def short_source_path(source, boundary_regex=DEFAULT_PATH_BOUNDARY_REGEX):
    """Return a compact source label, preserving context before temp trees."""
    source = Path(source).resolve()
    directories = source.parts[:-1]
    try:
        boundary = re.compile(boundary_regex)
    except re.error as error:
        raise ValueError(f"invalid path boundary regex: {error}") from error

    for index in range(len(directories) - 1, 1, -1):
        if boundary.fullmatch(directories[index]):
            meaningful_descendants = directories[index + 2:]
            return str(
                Path(directories[index - 1])
                / "..."
                / Path(*meaningful_descendants)
                / source.name
            )
    return str(Path(source.parent.name) / source.name)


class Preview:
    def __init__(self, args):
        self.source = Path(args.source)
        self.output = Path(args.output) if args.output else self.source
        configured_root = getattr(args, "serve_root", None)
        self.serve_root = (
            Path(configured_root).resolve()
            if configured_root
            else self.output.parent.resolve()
        )
        self.css = Path(args.css) if args.css else None
        self.source_label = Path(args.source_label) if args.source_label else None
        self.fallback_title = args.fallback_title
        self.path_boundary_regex = args.path_boundary_regex
        self.mode = args.mode
        self.ready = Path(args.ready)
        self.pidfile = Path(args.pidfile)
        self.idle_timeout = args.idle_timeout
        self.startup_timeout = args.startup_timeout
        self.clients = {}
        self.clients_lock = threading.Lock()
        self.had_client = False
        self.empty_since = None
        self.shutdown_requested = threading.Event()
        self.shutdown_token = secrets.token_urlsafe(24)
        self.render_lock = threading.RLock()
        self.rendered_signature = None
        self.sync_error = None

    def refresh(self):
        """Check source independently of watcher notifications; retry failed renders."""
        with self.render_lock:
            signature = file_signature(self.source)
            if signature is None:
                self.sync_error = "Source unavailable"
                return False
            if signature == self.rendered_signature:
                self.sync_error = None
                return False
            try:
                rendered = self.render()
            except (OSError, subprocess.SubprocessError) as error:
                print(f"live-preview: render failed: {error}", file=sys.stderr)
                rendered = False
            if not rendered:
                self.sync_error = "Render failed — retrying"
                return False
            # A save racing Pandoc must be checked again, never certified current.
            if file_signature(self.source) != signature:
                self.sync_error = "Source changing — retrying"
                return False
            self.rendered_signature = signature
            self.sync_error = None
            return True

    def render_linked_markdown(self, source):
        """Render a repository Markdown link without creating another server."""
        result = subprocess.run(
            ["pandoc", str(source), "--from=gfm", "--to=html5", "--standalone",
             f"--metadata=pagetitle={self.document_title_for(source)}"],
            text=True, capture_output=True, check=True,
        )
        return result.stdout

    def document_title_for(self, source):
        try:
            for line in Path(source).read_text(encoding="utf-8").splitlines():
                if line.startswith("# ") and line[2:].strip():
                    return line[2:].strip()
        except OSError:
            pass
        return self.fallback_title

    def synchronization(self, linked_source=None):
        # Heartbeats verify the content, not merely the HTTP connection. This also
        # repairs a missed polling iteration or a stalled watcher thread.
        if linked_source is not None:
            try:
                rendered = self.render_linked_markdown(linked_source)
                return {"revision": hashlib.sha256(rendered.encode("utf-8")).hexdigest(),
                        "error": None, "checked_at": round(time.time() * 1000),
                        "version": VERSION}
            except (OSError, subprocess.SubprocessError):
                return {"revision": None, "error": "Source unavailable",
                        "checked_at": round(time.time() * 1000), "version": VERSION}
        with self.render_lock:
            self.refresh()
            try:
                revision = hashlib.sha256(self.output.read_bytes()).hexdigest()
            except OSError:
                revision = None
                self.sync_error = "Preview unavailable"
            return {"revision": revision, "error": self.sync_error,
                    "checked_at": round(time.time() * 1000), "version": VERSION}

    def render(self):
        if self.mode == "html":
            return self.source.is_file()
        title = self.document_title()
        result = subprocess.run(
            [
                "pandoc", str(self.source), "--from=gfm", "--to=html5", "--standalone",
                f"--metadata=pagetitle={title}", f"--css={self.css.name}",
                f"--include-before-body={self.source_label}",
                f"--output={self.output}",
            ],
            text=True,
            capture_output=True,
        )
        if result.returncode:
            sys.stderr.write(result.stderr)
            return False
        return True

    def document_title(self):
        return self.document_title_for(self.source)

    def html(self, linked_source=None):
        source = Path(linked_source) if linked_source is not None else self.source
        with self.render_lock:
            data = (self.render_linked_markdown(source) if linked_source is not None
                    else self.output.read_bytes().decode("utf-8"))
        return self.decorate(data, linked_source)

